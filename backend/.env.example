# Supabase PostgreSQL connection string. Keep real credentials in backend/.env only.
# For example: postgresql+psycopg://postgres:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=

# AI provider selection. Default is 'mock' (deterministic keyword heuristics, no API key needed).
# Set to 'gemini' (with GEMINI_API_KEY) when ready to use a real model.
AI_PROVIDER=mock
# GEMINI_API_KEY=
